# Copy this file to .env before starting the stack.
# These are development-only defaults; replace every password/token locally.

INFLUX_USERNAME=iotadmin
INFLUX_PASSWORD=change-me-influx-password
INFLUX_ORG=iot-lab
INFLUX_TOKEN=change-me-influx-super-secret-token
INFLUX_RAW_BUCKET=iot_raw
INFLUX_PROCESSED_BUCKET=iot_processed
INFLUX_URL=http://127.0.0.1:8086

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Keep the lab services local to this computer by default. Set 0.0.0.0 only
# when another machine on a trusted lab network really needs to connect.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_HOST=127.0.0.1
MQTT_PORT=1884
MQTT_TOPIC=iot/lab2/+/telemetry
MQTT_CLIENT_ID=iot-lab2-python-gateway
MQTT_QOS=1
INFLUX_BIND_ADDRESS=127.0.0.1
GRAFANA_BIND_ADDRESS=127.0.0.1

LOCATION=wokwi-lab
GATEWAY_LOG_LEVEL=INFO
