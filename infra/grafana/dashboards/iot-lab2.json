      "id": 1,
      "options": {
        "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "iot-influx-raw" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_raw\" and r._field == \"temperature_c\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"raw\")",
          "refId": "A"
        },
        {
          "datasource": { "type": "influxdb", "uid": "iot-influx-processed" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_processed_1m\" and (r._field == \"temperature_c\" or r._field == \"temperature_c_rolling_5m\"))\n  |> yield(name: \"processed\")",
          "refId": "B"
        }
      ],
      "title": "Nhiệt độ: raw và rolling mean 5 phút",
      "type": "timeseries"
    },
